;; Eshkol v1.3.6 Toner Quantum CHSH Monogamy (T7a) & Hiding-Binding Conservation (T7b)
;; Forward-Mode Dual-Number AD Sensitivity Module.

;; Theorem T7a: Maximal Eve CHSH score under Toner quantum monogamy S_AB^2 + S_AE^2 <= 8
(define (toner-max-eve-chsh s-ab)
  (sqrt (- 8.0 (* s-ab s-ab))))

;; Theorem T7a (CKW): Residual Berry monopole ceiling r_A(C_AB) = sqrt(1 - C_AB^2)
(define (ckw-monopole-ceiling c-ab)
  (sqrt (- 1.0 (* c-ab c-ab))))

;; Theorem T7b: Forced commitment equivocation overlap Overlap(TV) = 1 - TV
(define (commitment-overlap tv)
  (- 1.0 tv))

;; Exact Conservation Residual TV + Overlap(TV) - 1 == 0
(define (commitment-conservation-err tv)
  (- (+ tv (commitment-overlap tv)) 1.0))

;; Theorem T7c (Fuchs-van de Graaff / Microcrypt EFI): Upper fidelity ceiling B_max(TV) = sqrt(1 - TV^2)
(define (fuchs-vdg-fidelity-ceil tv)
  (sqrt (- 1.0 (* tv tv))))

(with-region 'secmesh-monogamy-commitment-ad
  (let* ((s0 2.4)
         (s-ae (toner-max-eve-chsh s0))
         (dsae-dsab (derivative toner-max-eve-chsh s0))
         (c0 0.6)
         (dr-dc (derivative ckw-monopole-ceiling c0))
         (tv0 0.1)
         (cons-err (commitment-conservation-err tv0))
         (dov-dtv (derivative commitment-overlap tv0))
         (tv-efi 0.8)
         (b-ceil (fuchs-vdg-fidelity-ceil tv-efi))
         (db-dtv (derivative fuchs-vdg-fidelity-ceil tv-efi)))
    (display "SecMesh-PQSI Eshkol Monogamy & Commitment AD Report") (newline)
    (display "  T7a max S_AE at S_AB=2.4           = ") (display s-ae) (newline)
    (display "  T7a d(S_AE)/d(S_AB) at S_AB=2.4    = ") (display dsae-dsab) (newline)
    (display "  T7a CKW d(r_A)/d(C_AB) at C_AB=0.6 = ") (display dr-dc) (newline)
    (display "  T7b conservation err at TV=0.1     = ") (display cons-err) (newline)
    (display "  T7b d(Overlap)/d(TV) at TV=0.1     = ") (display dov-dtv) (newline)
    (display "  T7c B_max(0.8) Pythagorean ceiling = ") (display b-ceil) (newline)
    (display "  T7c d(B_max)/d(TV) at TV=0.8       = ") (display db-dtv) (newline)))
