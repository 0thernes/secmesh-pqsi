cff-version: 1.2.0
message: "If you use SecMesh-PQSI, its Lean 4.35 proofs, or companion white papers, please cite this work as below."
title: "SecMesh-PQSI: Formal Algebraic and Information-Theoretic Foundations and Cryptographic Defense Engine for Post-Quantum and Post-Super-Intelligence Meshes"
version: "2.5.0"
date-released: "2026-11-25"
type: software
license: Apache-2.0
repository-code: "https://github.com/0thernes/secmesh-pqsi"
url: "https://github.com/0thernes/secmesh-pqsi"
authors:
  - family-names: "Donahue"
    given-names: "Alexander S."
    orcid: "https://orcid.org/0009-0006-8168-9648"
